{
  "anh-xa": "f:A\\to B,\\qquad f(A)=\\{f(x):x\\in A\\}\\subseteq B",
  "cong": "N=N_1+N_2+\\cdots+N_r",
  "nhan": "N=m_1m_2\\cdots m_r",
  "bu-tru": "\\begin{aligned}|A\\cup B|&=|A|+|B|-|A\\cap B|\\\\|A\\cup B\\cup C|&=|A|+|B|+|C|\\\\&\\quad-|A\\cap B|-|A\\cap C|-|B\\cap C|\\\\&\\quad+|A\\cap B\\cap C|\\end{aligned}",
  "dirichlet": "\\max_i n_i\\ge\\left\\lceil\\frac{n}{m}\\right\\rceil,\\quad m\\ge1;\\qquad n\\ge m(r-1)+1",
  "hoan-vi": "P(n)=n!,\\quad n\\in\\mathbb Z_{\\ge0}",
  "chinh-hop": "A(n,k)=\\frac{n!}{(n-k)!},\\quad 0\\le k\\le n",
  "to-hop": "\\binom nk=\\frac{n!}{k!(n-k)!}=\\binom n{n-k}",
  "nhom-gioi-tinh": "\\sum_{i=\\max(0,k-b)}^{\\min(a,k)}\\binom ai\\binom b{k-i}",
  "pascal-newton": "\\begin{aligned}\\binom nk&=\\binom{n-1}{k-1}+\\binom{n-1}k\\\\(x+y)^n&=\\sum_{k=0}^{n}\\binom nk x^{n-k}y^k\\end{aligned}",
  "hoan-vi-lap": "\\frac{n!}{n_1!n_2!\\cdots n_r!},\\qquad\\sum_{i=1}^r n_i=n",
  "stars-bars": "\\begin{gathered}x_1+\\cdots+x_r=N,\\quad x_i\\in\\mathbb Z_{\\ge0}\\\\\\#=\\binom{N+r-1}{r-1},\\quad N\\ge0,\\ r\\ge1\\end{gathered}",
  "can-duoi": "y_i=x_i-L_i\\ge0,\\qquad\\sum_i y_i=N-\\sum_i L_i",
  "can-tren": "[x^N]\\prod_{i=1}^r(1+x+\\cdots+x^{U_i})",
  "phan-chia": "\\frac{n!}{n_1!\\cdots n_r!(n-\\sum_i n_i)!}",
  "lap-truy-hoi": "a_n=q^n a_0+b\\sum_{j=0}^{n-1}q^j",
  "lai-kep": "a_n=M(1+r)^n",
  "hanoi": "H_0=0,\\qquad H_n=2H_{n-1}+1=2^n-1",
  "fibonacci": "\\begin{gathered}F_0=0,\\quad F_1=1,\\quad F_n=F_{n-1}+F_{n-2}\\ (n\\ge2)\\\\F_n=\\frac{\\varphi^n-\\psi^n}{\\sqrt5},\\quad\\varphi=\\frac{1+\\sqrt5}2,\\quad\\psi=\\frac{1-\\sqrt5}2\\end{gathered}",
  "gf-dinh-nghia": "A(x)=\\sum_{n\\ge0}a_nx^n,\\qquad[x^n]A(x)=a_n",
  "gf-phep-toan": "A^\\prime(x)=\\sum_{n\\ge0}(n+1)a_{n+1}x^n",
  "gf-tich": "[x^n](A(x)B(x))=\\sum_{k=0}^n a_kb_{n-k}",
  "gf-dem-sach": "[x^{10}](1+x)^{13}(1+x+x^2)^2",
  "gf-truy-hoi": "U(x)=\\frac{u_0+(u_1-au_0)x}{1-ax-bx^2}",
  "gf-cap-mot": "\\sum_{j=0}^n a^{n-j}b^j=\\begin{cases}\\dfrac{a^{n+1}-b^{n+1}}{a-b},&a\\ne b\\\\(n+1)a^n,&a=b\\end{cases}",
  "dac-trung-co-ban": "P(r)=r^k-c_1r^{k-1}-\\cdots-c_k=0",
  "phan-biet": "a_n=A r_1^n+B r_2^n,\\qquad r_1\\ne r_2",
  "nghiem-lap": "(A_0+A_1n+\\cdots+A_{m-1}n^{m-1})r^n",
  "nghiem-phuc": "\\begin{gathered}r=\\rho(\\cos\\theta\\pm i\\sin\\theta)\\\\a_n=\\rho^n[A\\cos(n\\theta)+B\\sin(n\\theta)]\\end{gathered}",
  "bai-nang-cao": "x_0=x_1=0,\\qquad x_{n+2}-6x_{n+1}+9x_n=2^n+n"
}